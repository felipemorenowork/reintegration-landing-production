# Create these variables in Cloudflare Pages before deploying.
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. Cloudflare Pages Web Analytics is normally enabled from Pages > Metrics.
# Leave empty when using that one-click setup.
NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=

# Optional public Formspark form ID override for previews. The current form ID is
# already the default in the landing source, so production does not require this.
NEXT_PUBLIC_FORMSPARK_FORM_ID=2nSg9GLsk
